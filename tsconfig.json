{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "/opt/npm-tools/node_modules/@types"]
  },
  "include": ["server/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
