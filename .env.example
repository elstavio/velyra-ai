# ===== Velyra AI — configuration (copiez en .env ; ne commitez JAMAIS le vrai fichier) =====
NODE_ENV=production
PORT=3000
# URL publique du backend (https obligatoire en production). Sert aux retours/notifications de paiement.
APP_URL=https://velyra-api.onrender.com
# Base PostgreSQL (Neon, Supabase, Render…). Obligatoire en production.
DATABASE_URL=postgres://utilisateur:motdepasse@hote/base?sslmode=require
# Clé de chiffrement AES-256 : générez-la avec  openssl rand -base64 32  (sauvegardez-la : sans elle les numéros chiffrés sont illisibles)
ENCRYPTION_KEY=
# Si le frontend est hébergé ailleurs (Netlify), son URL exacte ; sinon laisser vide.
CORS_ORIGIN=
# Nombre de proxys devant l'app (Render = 1) pour lire la vraie adresse IP.
TRUST_PROXY_HOPS=1

# --- Administrateur (créé UNE fois au premier démarrage, puis supprimez ADMIN_INITIAL_PASSWORD) ---
ADMIN_EMAIL=vous@exemple.com
ADMIN_INITIAL_PASSWORD=
OWNER_NOTIFY_EMAIL=
OWNER_NOTIFY_PHONE=

# --- Paiements CinetPay (https://docs.cinetpay.com) ---
PAYMENT_PROVIDER=cinetpay
PAYOUT_PROVIDER=cinetpay
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_TRANSFER_PASSWORD=

# --- Email (Resend) et SMS (Twilio) : sans eux, les codes s'affichent seulement dans les journaux (dev) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Velyra AI <no-reply@votre-domaine.com>
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Connexion Google (facultatif) ---
GOOGLE_CLIENT_ID=

# --- Fournisseurs d'IA : au moins une clé, sinon l'IA répond en mode démonstration ---
AI_DEFAULT_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
MISTRAL_API_KEY=
MISTRAL_MODEL=

# --- Agents IA internes (5 agents + superviseur, exécutés chaque jour) ---
# Modèle économique conseillé pour les analyses quotidiennes ; sans clé, les agents tournent avec des synthèses par règles.
SYSTEM_AGENT_PROVIDER=openai
SYSTEM_AGENT_MODEL=gpt-6-luna
# Secret du planificateur externe (Render gratuit s'endort) : appelez POST APP_URL/api/cron/daily avec l'en-tête x-cron-secret
CRON_SECRET=

# --- Paiements Europe : Stripe (carte, Apple Pay, Google Pay, SEPA) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Connexion Apple (Services ID, pas l'App ID) ---
APPLE_CLIENT_ID=

# --- Réseaux sociaux (offre payante « Social ») : une application développeur par plateforme, À FAIRE VALIDER par chacune ---
# URL de retour (redirect URI) à déclarer partout : APP_URL/api/social/callback/<tiktok|youtube|facebook|instagram>
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# --- Réglages ---
TRIAL_TASKS=5
DAILY_TASK_CAP=300

# --- Sécurité renforcée : anti-DDoS/DoS, piège anti-intrusion, confirmation des retraits ---
# Rafale par IP avant ralentissement (429) ; blocage automatique (403) à 4x ce seuil sur la même fenêtre.
RL_API_BURST_PER_IP_SEC=15
RL_API_BURST_WINDOW_MS=2000
# Durée de conservation des informations captées par le piège anti-intrusion avant purge automatique.
HONEYPOT_RETENTION_DAYS=10
# Durée de validité du lien de confirmation envoyé par email avant tout retrait (automatique ou admin).
PAYOUT_CONFIRM_TTL_HOURS=24
